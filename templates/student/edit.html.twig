{% extends 'base.html.twig' %}

{% block title %}Modifier l'étudiant{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="fw-bold mb-3">Modifier l'étudiant</h4>
            
            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.nom) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.prenom) }}
                    </div>
                    <div class="col-md-12">
                        {{ form_row(form.email) }}
                    </div>
                    <div class="col-md-12">
                        {{ form_row(form.filiere) }}
                    </div>
                    <div class="col-md-12">
                        {{ form_row(form.theme) }}
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="{{ path('admin_student_index') }}" class="btn btn-light">Annuler</a>
                    <button type="submit" class="btn btn-primary px-4">Mettre à jour</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
