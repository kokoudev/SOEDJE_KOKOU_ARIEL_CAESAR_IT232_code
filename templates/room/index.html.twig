{% extends 'base.html.twig' %}

{% block title %}Gestion des Salles{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Gestion des Salles</h4>
        <p class="text-muted small mb-0">Configuration des espaces et capacités d'accueil pour soutenances</p>
    </div>
    <a href="{{ path('admin_room_new') }}" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Ajouter une salle
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code Salle</th>
                    <th>Capacité</th>
                    <th>Localisation</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for room in rooms %}
                    <tr>
                        <td class="fw-bold text-primary">{{ room.code }}</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">{{ room.capacite }} places</span></td>
                        <td class="text-muted">{{ room.localisation }}</td>
                        <td class="text-end">
                            <a href="{{ path('admin_room_edit', {'id': room.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('admin_room_delete', {'id': room.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette salle ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ room.id) }}">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Aucune salle disponible.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
